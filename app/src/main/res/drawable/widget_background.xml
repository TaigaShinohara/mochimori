<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget panel (v0.3.12; flattened in v0.3.21): a plain surface panel —
  the theme's surface colour as a solid fill with rounded corners, no
  gradient and no specular edge (the v0.3.21 M3 standardisation removed
  the glass treatment here as it did inside the app). The colour is
  referenced through the m3_surface token, so this one file serves both
  schemes (values-night/colors.xml swaps the value); the dark variant
  file that duplicated it is gone.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/m3_surface" />
    <corners android:radius="20dp" />
</shape>
