<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only the write-settings capability is used (via the system grant
         screen). No accessibility, no WRITE_SECURE_SETTINGS, no device admin.
         VIBRATE (v0.3.5, at the user's request) is a normal permission — no
         dialog — used only for the face's motion-synced haptic feedback. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MochiApp"
        android:allowBackup="true"
        android:label="もち守り"
        android:theme="@style/Theme.MochiMori">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Periodic battery check (AlarmManager, ~15 min). Not exported. -->
        <receiver
            android:name=".BatteryCheckReceiver"
            android:exported="false" />
        <!-- Home-screen widget (v0.3.12). APPWIDGET_UPDATE is a
             system-sent broadcast, so exported=false is safe; no extra
             permission is involved (no boot receiver — updates ride the
             30-min system schedule and the app's own periodic check). -->
        <receiver
            android:name=".MochiWidgetProvider"
            android:exported="false"
            android:label="もち守り">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mochi_info" />
        </receiver>
    </application>
</manifest>
